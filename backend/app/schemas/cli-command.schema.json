{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lynewright.dev/schemas/cli-command.schema.json",
  "title": "Lynewright CLI wrapper command declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "argv",
    "params",
    "outputs",
    "limits"
  ],
  "properties": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "params": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {},
          "derive": {
            "type": "object",
            "required": [
              "from",
              "format"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "format": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "object",
        "required": [
          "extensions",
          "max_bytes"
        ],
        "properties": {
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.[a-zA-Z0-9]{1,10}$"
            },
            "maxItems": 30
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "glob"
      ],
      "properties": {
        "glob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_*?.-]+$"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "max_output_bytes",
        "max_concurrent_jobs"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_concurrent_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    }
  }
}
