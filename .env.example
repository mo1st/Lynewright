# Manual Compose keeps its current all-interface bind; install.sh creates a loopback-only .env.
LYNEWRIGHT_BOOTSTRAP_EMAIL=admin@example.com
LYNEWRIGHT_BOOTSTRAP_PASSWORD=change-this-placeholder-before-first-login
# These defaults preserve direct docker compose behavior; install.sh changes the bind to 127.0.0.1.
LYNEWRIGHT_BIND=0.0.0.0
LYNEWRIGHT_PORT=8080
# install.sh sets these to the account that owns the mounted data on the host.
LYNEWRIGHT_UID=1000
LYNEWRIGHT_GID=1000
# Managed files use the persistent /data volume in Docker Compose.
LYNEWRIGHT_MANAGED_MEDIA_DIR=/data/media
LYNEWRIGHT_DEMO=1
LYNEWRIGHT_PLUGINS=app.integrations.demo.bootstrap
# Empty by default. List installed Python distribution names to opt them in.
# Verified catalogue wheels are stored on the persistent /data volume.
LYNEWRIGHT_PACKAGES_DIR=/data/packages
# Host-side bind directory used as the runner image build context.
LYNEWRIGHT_PACKAGES_HOST_DIR=./data/packages
# Signed catalogue artifact caps; values above these hard ceilings are clamped.
LYNEWRIGHT_CATALOGUE_FILE_MAX_BYTES=1048576
LYNEWRIGHT_CATALOGUE_WHEEL_MAX_BYTES=104857600
# Development signing key trust is disabled by default; local testing only.
LYNEWRIGHT_CATALOGUE_ALLOW_DEV_KEY=0
# Optional signed catalogue settings. Use an operator-owned public key in production.
LYNEWRIGHT_CATALOGUE_URL=
LYNEWRIGHT_CATALOGUE_KEYS=
LYNEWRIGHT_CATALOGUE_INTERNAL_ENDPOINT_REF=
LYNEWRIGHT_INSTALL_POLICY=confirm
LYNEWRIGHT_INTEGRATION_PACKAGES=
# Public origin used by MCP OAuth and file links. Use your HTTPS URL behind a TLS proxy.
LYNEWRIGHT_PUBLIC_URL=http://localhost:8080
LYNEWRIGHT_MCP_OAUTH_ENABLED=1
# Optional API origin reachable by tools on the same private container network.
LYNEWRIGHT_INTERNAL_MEDIA_URL=http://127.0.0.1:8000
# Only used with docker compose --profile cli-example; this is an internal origin.
LYNEWRIGHT_INTERNAL_ENDPOINT__CLI_THUMBNAIL=http://cli-thumbnail:8001
LYNEWRIGHT_TELEGRAM_ENABLED=0
